{
	"schemaVersion": 1,
	"id": "${id}",
	"name": "${display_name}",
	"version": "${modversion}",
	"description": "${description}",
	"authors": [
		"noramibu",
		"Toni",
		"Mephodio"
	],
	"contact": {
		"sources": "https://github.com/noramibu/Cerulean/branches",
		"issues": "https://github.com/noramibu/Cerulean/issues"
	},
	"license": "${license}",
	"icon": "assets/${id}/textures/mod_logo.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"${group}.${namespace}.${name}"
		],
		"client": [
			"${group}.${namespace}.${name}"
		]
	},
	"mixins": [
		"mixins.${mixinid}.json"
	],
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "${discord}"
			}
		}
	},
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": ">=26.1 <=26.1.1",
		"fabric-api": "*"
	}
}
